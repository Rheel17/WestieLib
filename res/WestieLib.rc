IDD_SETTINGS DIALOGEX 0, 0, 308, 158
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	GROUPBOX        "Library", -1, 9, 7, 290, 30
	LTEXT           "&Folder:", -1, 16, 22, 26, 8
	EDITTEXT        IDC_LIBRARY_FOLDER, 45, 20, 200, 12, ES_AUTOHSCROLL | ES_READONLY
	PUSHBUTTON      "&Change…", IDC_CHANGE_LIBRARY_FOLDER, 250, 20, 43, 12
	GROUPBOX        "Tools", -1, 9, 43, 290, 85
	CONTROL         "", IDC_TOOLS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 16, 56, 277, 40
	AUTOCHECKBOX    "Update tools &automatically", IDC_AUTO_UPDATE_TOOLS, 16, 102, 150, 10
	PUSHBUTTON      "Check for &updates", IDC_CHECK_FOR_UPDATES, 227, 101, 66, 12
	LTEXT           "", IDC_LAST_CHECKED, 16, 115, 200, 8
	LTEXT           "", IDC_VERSION, 9, 141, 150, 8
	DEFPUSHBUTTON   "OK", IDOK, 208, 139, 43, 12
	PUSHBUTTON      "Cancel", IDCANCEL, 256, 139, 43, 12
END

IDD_ADD_PLAYLIST DIALOGEX 0, 0, 360, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add playlist"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	LTEXT           "Paste a link to a public YouTube Music or Spotify playlist.", -1, 9, 9, 342, 8
	LTEXT           "Playlist &link:", -1, 9, 24, 342, 8
	EDITTEXT        IDC_PLAYLIST_LINK, 9, 34, 342, 12, ES_AUTOHSCROLL
	CONTROL         "", IDC_PLAYLIST_KIND, "Static", SS_OWNERDRAW, 9, 50, 342, 10
	AUTOCHECKBOX    "Sync &now", IDC_SYNC_NOW, 9, 66, 100, 10
	DEFPUSHBUTTON   "Add", IDOK, 243, 85, 60, 12
	PUSHBUTTON      "Cancel", IDCANCEL, 308, 85, 43, 12
END

IDD_CHOOSE_VIDEO DIALOGEX 0, 0, 370, 237
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose a video"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	CONTROL         "", IDC_VIDEO_SOURCE, "Static", SS_OWNERDRAW, 9, 8, 352, 10
	LTEXT           "", IDC_VIDEO_CURRENT, 9, 20, 352, 8, SS_ENDELLIPSIS | SS_NOPREFIX
	LTEXT           "&Search YouTube Music:", -1, 9, 36, 352, 8
	EDITTEXT        IDC_VIDEO_QUERY, 9, 46, 302, 12, ES_AUTOHSCROLL
	PUSHBUTTON      "Search", IDC_VIDEO_SEARCH, 316, 46, 45, 12
	CONTROL         "", IDC_VIDEO_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 9, 64, 352, 104
	LTEXT           "Or paste a YouTube or YouTube Music &link:", -1, 9, 176, 352, 8
	EDITTEXT        IDC_VIDEO_LINK, 9, 186, 352, 12, ES_AUTOHSCROLL
	CONTROL         "", IDC_VIDEO_LINK_KIND, "Static", SS_OWNERDRAW, 9, 202, 352, 10
	PUSHBUTTON      "&Open in browser", IDC_OPEN_VIDEO, 9, 218, 64, 12
	DEFPUSHBUTTON   "&Use this video", IDOK, 254, 218, 60, 12
	PUSHBUTTON      "Cancel", IDCANCEL, 318, 218, 43, 12
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "WestieLib.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WESTIELIB_VERSION_MAJOR, WESTIELIB_VERSION_MINOR, WESTIELIB_VERSION_PATCH, 0
PRODUCTVERSION WESTIELIB_VERSION_MAJOR, WESTIELIB_VERSION_MINOR, WESTIELIB_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "WestieLib"
			VALUE "FileVersion", WESTIELIB_VERSION_STRING
			VALUE "InternalName", "WestieLib"
			VALUE "OriginalFilename", "WestieLib.exe"
			VALUE "ProductName", "WestieLib"
			VALUE "ProductVersion", WESTIELIB_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
