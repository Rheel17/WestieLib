#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>

#include "ResourceIds.h"
#include "Version.h"

IDI_APP_ICON ICON "WestieLib.ico"

IDI_PLUS             ICON "glyphs/plus.ico"
IDI_PLUS_DISABLED    ICON "glyphs/plus-disabled.ico"
IDI_SYNCING          ICON "glyphs/syncing.ico"
IDI_SYNCING_DISABLED ICON "glyphs/syncing-disabled.ico"
IDI_STOP             ICON "glyphs/stop.ico"
IDI_STOP_DISABLED    ICON "glyphs/stop-disabled.ico"
IDI_GEAR             ICON "glyphs/gear.ico"
IDI_GEAR_DISABLED    ICON "glyphs/gear-disabled.ico"
IDI_LIBRARY          ICON "glyphs/lib.ico"
IDI_SYNCED           ICON "glyphs/synced.ico"
IDI_WARN             ICON "glyphs/warn.ico"

IDD_SETTINGS DIALOGEX 0, 0, 308, 158
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	GROUPBOX        "Library", -1, 9, 7, 290, 30
	LTEXT           "&Folder:", -1, 16, 22, 26, 8
	EDITTEXT        IDC_LIBRARY_FOLDER, 45, 20, 200, 12, ES_AUTOHSCROLL | ES_READONLY
	PUSHBUTTON      "&Change…", IDC_CHANGE_LIBRARY_FOLDER, 250, 20, 43, 12
	GROUPBOX        "Tools", -1, 9, 43, 290, 85
	CONTROL         "", IDC_TOOLS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 16, 56, 277, 40
	AUTOCHECKBOX    "Update tools &automatically", IDC_AUTO_UPDATE_TOOLS, 16, 102, 150, 10
	PUSHBUTTON      "Check for &updates", IDC_CHECK_FOR_UPDATES, 227, 101, 66, 12
	LTEXT           "", IDC_LAST_CHECKED, 16, 115, 200, 8
	LTEXT           "", IDC_VERSION, 9, 141, 150, 8
	DEFPUSHBUTTON   "OK", IDOK, 208, 139, 43, 12
	PUSHBUTTON      "Cancel", IDCANCEL, 256, 139, 43, 12
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "WestieLib.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WESTIELIB_VERSION_MAJOR, WESTIELIB_VERSION_MINOR, WESTIELIB_VERSION_PATCH, 0
PRODUCTVERSION WESTIELIB_VERSION_MAJOR, WESTIELIB_VERSION_MINOR, WESTIELIB_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "WestieLib"
			VALUE "FileVersion", WESTIELIB_VERSION_STRING
			VALUE "InternalName", "WestieLib"
			VALUE "OriginalFilename", "WestieLib.exe"
			VALUE "ProductName", "WestieLib"
			VALUE "ProductVersion", WESTIELIB_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
