#include <windows.h>

#include "ResourceIds.h"
#include "Version.h"

IDI_APP_ICON ICON "WestieLib.ico"

IDI_PLUS             ICON "glyphs/plus.ico"
IDI_PLUS_DISABLED    ICON "glyphs/plus-disabled.ico"
IDI_SYNCING          ICON "glyphs/syncing.ico"
IDI_SYNCING_DISABLED ICON "glyphs/syncing-disabled.ico"
IDI_STOP             ICON "glyphs/stop.ico"
IDI_STOP_DISABLED    ICON "glyphs/stop-disabled.ico"
IDI_GEAR             ICON "glyphs/gear.ico"
IDI_GEAR_DISABLED    ICON "glyphs/gear-disabled.ico"
IDI_LIBRARY          ICON "glyphs/lib.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "WestieLib.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WESTIELIB_VERSION_MAJOR, WESTIELIB_VERSION_MINOR, WESTIELIB_VERSION_PATCH, 0
PRODUCTVERSION WESTIELIB_VERSION_MAJOR, WESTIELIB_VERSION_MINOR, WESTIELIB_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "WestieLib"
			VALUE "FileVersion", WESTIELIB_VERSION_STRING
			VALUE "InternalName", "WestieLib"
			VALUE "OriginalFilename", "WestieLib.exe"
			VALUE "ProductName", "WestieLib"
			VALUE "ProductVersion", WESTIELIB_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
